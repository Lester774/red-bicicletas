extends layout

block content
  h1= title
  p Bienvenido a #{title}
  
  div#main_map(style='height: 400px; width: 100%;')

  script.
    var map = L.map('main_map').setView([14.0723, -87.1921], 13);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    fetch('/api/bicicletas')
      .then(response => response.json())
      .then(data => {
        data.bicicletas.forEach(bici => {
          L.marker(bici.ubicacion).addTo(map)
            .bindPopup(`<b>Bicicleta ID: ${bici.id}</b><br>Color: ${bici.color}<br>Modelo: ${bici.modelo}`);
        });
      });